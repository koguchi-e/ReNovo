<section class="task-list__content" aria-label="タスクの追加操作">
  <div class="task-list__review-action flex w-full justify-center">
    <%= render "/situations/review_modal", situation: situation, full_width: true %>
  </div>
<section class="task-list__empty-state mx-auto mt-8 flex w-full max-w-xl flex-col items-center py-6 text-center" aria-labelledby="empty-task-heading">
  <h2 id="empty-task-heading" class="text-2xl font-bold text-dark-blue">
    タスクはまだありません
  </h2>
  <p class="task-list__empty-description mt-3 max-w-lg text-base leading-relaxed text-calm-blue">
    タスクを追加して、次の行動を整理しましょう。
  </p>
  <div class="mt-7 flex w-full flex-col items-center gap-3">
    <%= render "create_form", situation: situation, new_task: new_task, full_width: true, primary_button: true, open_form: local_assigns[:open_new_task_form], heading: "タスクの追加" %>
  </div>
</section>
</section>
