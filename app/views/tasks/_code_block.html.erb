<section class="mt-5 w-full rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
  <h2 class="text-2xl font-bold text-dark-blue">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
    作成したタスクリスト
  </h2>
  <hr class="mt-3 border border-gray-200">

  <% if situation.tasks.exists? %>
    <p class="mt-8 text-base text-calm-blue">
      Markdown形式のチェックリストでコピーできます。
    </p>

    <div class="w-full mt-5" data-controller="clipboard">
      <div class="relative block rounded bg-gray-800 text-white">
        <div class="absolute top-0 right-0 ">
          <button class="mb-1 flex min-h-11 min-w-11 items-center justify-center rounded-bl rounded-tr bg-slate-400 px-2 hover:bg-slate-300" data-action="clipboard#copy" aria-label="Markdownをコピー">
            <span data-clipboard-target="icon">
              <i class="fa-solid fa-copy" aria-hidden="true"></i>
            </span>
            <span data-clipboard-target="message" class="font-bold" hidden>コピーしました</span>
          </button>
        </div>
        <pre class="overflow-x-auto px-4 pb-4 pt-4"><code data-clipboard-target="source"><% tasks.each do |task| %> - [ ] <%= task.content %><br><% end %></code></pre>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-start gap-3">
      <%= link_to situation_tasks_path(situation), class: "secondary-button" do %>
        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
        タスクを編集する
      <% end %>
    </div>

  <% else %>
    <section class="mt-5 flex flex-col items-start gap-3">
      <p class="mb-3 text-base text-calm-blue">
        タスクはまだありません。必要であれば、タスクを追加してください。
      </p>
      <%= link_to situation_tasks_path(situation, new_task: "open"), class: "primary-button self-center" do %>
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        タスクを追加する
      <% end %>
    </section>
  <% end %>
</section>
