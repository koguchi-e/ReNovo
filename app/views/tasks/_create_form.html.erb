<div data-controller="task-form" class="<%= local_assigns[:compact_button] ? "contents" : ("flex w-full flex-col items-center" if local_assigns[:full_width]) %>">
  <button type="button" data-task-form-target="button" data-action="task-form#create" class="action-button <%= "hidden" if local_assigns[:open_form] %> <%= local_assigns[:compact_button] ? "action-button--paired" : ("action-button--wide" if local_assigns[:full_width]) %> <%= local_assigns[:primary_button] ? "action-button--primary" : "action-button--secondary" %>" data-testid="open-task-form-button">
    <i class="fa-solid fa-plus" aria-hidden="true"></i> タスクを追加
  </button>
  <div data-task-form-target="createForm" class="relative <%= "hidden" unless local_assigns[:open_form] %> <%= local_assigns[:full_width] ? "w-full" : "w-[min(40rem,calc(100vw-2rem))]" %> rounded-2xl border border-gray-200 bg-white px-4 pb-3 pt-4 shadow-sm sm:px-6 sm:pb-4 sm:pt-6">
    <% if local_assigns[:heading] %>
      <header class="task-create__header mb-5 text-left">
        <h3 class="task-create__heading text-xl font-bold text-dark-blue">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          <%= heading %>
        </h3>
        <hr class="task-create__divider mt-3 border-gray-200">
      </header>
    <% end %>
    <%= form_with model: [situation, new_task] do |f| %>
      <%= f.text_area :content,
        rows: 3,
        placeholder: "例：机の上に教材を用意する",
        aria: { label: "新しいタスク内容" },
        class: "task-create__textarea min-h-10 w-full appearance-none resize-y rounded-lg border border-gray-300 bg-white px-4 py-3 leading-relaxed text-gray-700 shadow-inner placeholder:text-slate-400 focus:border-bright-orange focus:outline-none focus:ring-2 focus:ring-bright-orange/20",
        data: {
          testid: "new-task-content-input"
        } %>
      <div class="mt-3 flex w-full items-center justify-start gap-2">
        <%= f.button type: "submit", aria: { label: "タスクを作成" }, class: "action-button action-button--primary action-button--compact", data: { testid: "create-task-button" } do %>
          <i class="fa-solid fa-check" aria-hidden="true"></i>
        <% end %>
        <button type="button" aria-label="作成をキャンセル" data-action="task-form#createCancel" class="action-button action-button--secondary action-button--compact">
          <i class="fa-solid fa-x" aria-hidden="true"></i>
        </button>
      </div>
    <% end %>
  </div>
</div>
