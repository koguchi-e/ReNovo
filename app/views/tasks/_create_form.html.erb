<div data-controller="task-form" class="<%= "flex w-full flex-col items-center" if local_assigns[:full_width] %>">
  <button type="button" data-task-form-target="button" data-action="task-form#create" class="<%= local_assigns[:primary_button] ? "primary-button" : "secondary-button" %>" data-testid="open-task-form-button">
    <i class="fa-solid fa-plus" aria-hidden="true"></i> タスクを追加
  </button>
  <div data-task-form-target="createForm" class="relative hidden <%= local_assigns[:full_width] ? "w-full" : "w-[min(32rem,calc(100vw-2rem))]" %> rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
    <%= form_with model: [situation, new_task] do |f| %>
      <%= f.text_area :content,
        rows: 3,
        placeholder: "例：机の上に教材を用意する",
        aria: { label: "新しいタスク内容" },
        class: "form-textarea min-h-10",
        data: {
          testid: "new-task-content-input"
        } %>
      <div class="mt-3 flex w-full items-center justify-start gap-2">
        <%= f.button type: "submit", aria: { label: "タスクを作成" }, class: "icon-button-primary", data: { testid: "create-task-button" } do %>
          <i class="fa-solid fa-check" aria-hidden="true"></i>
        <% end %>
        <button type="button" aria-label="作成をキャンセル" data-action="task-form#createCancel" class="icon-button border border-calm-blue bg-white">
          <i class="fa-solid fa-x" aria-hidden="true"></i>
        </button>
      </div>
    <% end %>
  </div>
</div>
