<div data-controller="task-form" class="w-full">
  <button type="button" data-task-form-target="button" data-action="task-form#create" class="border border-calm-blue bg-white text-calm-blue hover:opacity-60 font-bold py-2 px-4 rounded hover:opacity-60" data-testid="open-task-form-button">
    <i class="fa-solid fa-plus"></i> タスクを追加
  </button>
  <div data-task-form-target="createForm" class="hidden p-10 relative border-2 rounded border-gray-200 hover:-translate-y-1 hover:scale-105">
    <%= form_with model: [situation, new_task] do |f| %>
      <%= f.text_field :content,
        class: "h-10 w-full appearance-none rounded border-2 border-gray-200 bg-gray-200 leading-tight text-gray-700 focus:border-bright-orange focus:bg-white focus:outline-none",
        data: {
          testid: "new-task-content-input"
        }
      %>
      <%= f.button type:"submit", class:"border border-calm-blue bg-calm-blue hover:opacity-60 text-white text-xs font-bold mt-3 py-2 px-4 rounded", data:{ testid:"create-task-button" } do %>
        <i class="fa-solid fa-check"></i>
      <% end %>
      <button type="button" data-action="task-form#createCancel" class="border border-calm-blue bg-white text-calm-blue hover:opacity-60 text-xs font-bold mt-3 py-2 px-4 rounded">
        <i class="fa-solid fa-x"></i>
      </button>
    <% end %>
  </div>
</div>
