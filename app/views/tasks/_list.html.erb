<div>
  <h1 class="flex items-center justify-center gap-3 text-4xl font-bold text-dark-blue">
    <i class="fa-solid fa-list-check" aria-hidden="true"></i>
    <span>タスク編集</span>
  </h1>
  <p class="mt-5 text-center text-xl text-calm-blue">
    タスクの追加・編集・削除・並べ替えができます。<br>
    ドラッグまたは上下ボタンで順番を変更できます。変更内容は自動で保存されます。
  </p>
</div>

<ul data-controller="task-order" class="mt-5">
  <% tasks.each do |task| %>
    <li
      data-controller="task-form"
      data-task-id="<%= task.id %>"
      data-task-position-url="<%= situation_position_path(situation) %>"
      class="relative m-5 rounded-2xl border border-gray-200 bg-white p-5 text-dark-blue shadow-sm sm:p-8">
      <div data-task-form-target="display">
        <span class="js-grab absolute left-8 top-1/2 -translate-y-1/2 cursor-grab">
          <i class="fa-solid fa-grip" aria-hidden="true"></i>
        </span>
        <% if task.position == 1 %>
          <span
            class="absolute left-8 top-1 inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-calm-blue sm:top-3"
            data-task-order-target="recommendation">
            <i class="fa-solid fa-flag" aria-hidden="true"></i>
            最初に取り組むタスク
          </span>
        <% end %>
        <div class="flex items-center gap-2 pl-12 pr-24">
          <div class="min-w-0 flex-1" data-task-order-target="content">
            <p class="break-words">
              <%= task.content %>
            </p>
          </div>
          <div class="flex shrink-0">
            <button type="button" data-action="task-form#edit"
              data-testid="edit-task-button"
              aria-label="タスクを編集"
              class="icon-button text-sm">
              <i class="fa-solid fa-pencil" aria-hidden="true"></i>
            </button>
            <%= button_to situation_task_path(situation, task), method: :delete, class: "icon-button-danger text-sm", aria: { label: "タスクを削除" }, data: { turbo_confirm: '本当に削除しますか？', testid: "delete-task-button-#{task.id}" } do %>
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            <% end %>
          </div>
        </div>
        <div class="absolute right-8 top-1/2 flex -translate-y-1/2 flex-col">
          <button
            type="button"
            data-action="task-order#moveUp"
            class="icon-button text-sm"
            aria-label="<%= "#{task.content}を上へ移動" %>">
            <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            data-action="task-order#moveDown"
            class="icon-button text-sm"
            aria-label="<%= "#{task.content}を下へ移動" %>">
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div data-task-form-target="form" class="hidden">
        <%= form_with model: [situation, task], method: :patch do |f| %>
          <%= f.text_area :content,
            rows: 3,
            placeholder: "例：机の上に教材を用意する",
            aria: { label: "タスク内容を編集" },
            class: "form-textarea min-h-10",
            data: {
              task_edit_target: "input",
              testid: "edit-task-content-input"
            } %>
          <div class="mt-3 flex w-full items-center justify-start gap-2">
            <%= f.button type: "submit", class: "icon-button-primary text-sm", data: { testid: "update-task-button" }, aria: { label: "タスクを更新" } do %>
              <i class="fa-solid fa-check" aria-hidden="true"></i>
            <% end %>
            <button type="button" data-action="task-form#editCancel" class="icon-button border border-calm-blue bg-white text-sm" aria-label="編集をキャンセル">
              <i class="fa-solid fa-x" aria-hidden="true"></i>
            </button>
          </div>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
<div class="m-5 flex flex-col items-center gap-3">
  <%= render "tasks/create_form", situation: situation, new_task: new_task, full_width: true %>
  <%= render "/situations/review_modal", situation: situation %>
</div>
<div class="m-5 flex justify-end">
  <%= link_to situation_path(situation), class: "primary-button" do %>
    <i class="fa-solid fa-check" aria-hidden="true"></i>
    完了
  <% end %>
</div>
