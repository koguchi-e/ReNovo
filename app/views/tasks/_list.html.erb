<div>
  <h2 class="flex items-center justify-center gap-3 text-4xl font-bold text-dark-blue">
    <i class="fa-solid fa-list-check" aria-hidden="true"></i>
    <span>タスク一覧</span>
  </h2>
  <p class="mt-5 text-center text-xl text-calm-blue">
    内容は自由に追加・編集・並べ替えできます。
  </p>
</div>

<% tasks.each_with_index do |task, index| %>
  <div data-controller="task-form" class="relative m-5 rounded-2xl border border-gray-200 bg-white p-5 text-dark-blue shadow-sm hover:-translate-y-1 hover:scale-[1.02] sm:p-8">
    <div data-task-form-target="display">
      <p class="break-words hover:opacity-60">
        <%= task.content %>
      </p>
      <div class="flex mt-2">
        <button type="button" data-action="task-form#edit"
          data-testid="edit-task-button"
          aria-label="タスクを編集"
          class="pr-2 hover:opacity-60">
          <i class="fa-solid fa-pencil" aria-hidden="true"></i>
        </button>
        <%= button_to situation_task_path(situation, task), method: :delete, class: "hover:opacity-60", aria: { label: "タスクを削除" }, data: { turbo_confirm: '本当に削除しますか？', testid: "delete-task-button-#{task.id}" } do %>
          <i class="fa-solid fa-trash" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>
    <div data-task-form-target="form" class="hidden">
      <%= form_with model: [situation, task], method: :patch do |f| %>
        <%= f.text_area :content,
          rows: 3,
          class: "min-h-10 w-full resize-y rounded border-2 border-gray-200 bg-gray-200 p-3 leading-relaxed text-gray-700 focus:border-bright-orange focus:bg-white focus:outline-none",
          data: {
            task_edit_target: "input",
            testid: "edit-task-content-input"
          }
        %>
        <div class="mt-3 flex w-full items-center justify-start gap-2">
          <%= f.button type: "submit", class: "border border-calm-blue bg-calm-blue hover:opacity-60 text-white text-xs font-bold py-2 px-4 rounded", data: { testid: "update-task-button" }, aria: { label: "タスクを更新" } do %>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
          <% end %>
          <button type="button" data-action="task-form#editCancel" class="border border-calm-blue bg-white text-calm-blue hover:opacity-60 text-xs font-bold py-2 px-4 rounded" aria-label="編集をキャンセル">
            <i class="fa-solid fa-x" aria-hidden="true"></i>
          </button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
<div class="m-5 flex flex-col items-center gap-3">
  <%= render "tasks/create_form", situation: situation, new_task: new_task, full_width: true %>
  <%= render "/situations/review_modal", situation: situation %>
</div>
<div class="m-5 flex justify-end">
  <%= link_to edit_situation_position_path(situation), class: "rounded border border-calm-blue bg-calm-blue px-4 py-2 font-bold text-white hover:opacity-60" do %>
    次へ
    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
  <% end %>
</div>
