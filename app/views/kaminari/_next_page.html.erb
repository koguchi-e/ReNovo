<%# Link to the "Next" page
  - available local variables
    url:           url to the next page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<span class="next inline-flex h-11 items-center justify-center gap-2 rounded-full border border-dark-blue bg-white px-5 font-medium  text-dark-blue hover:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-calm-blue focus-visible:ring-offset-2">
  <%= link_to_unless current_page.last?, t('views.pagination.next').html_safe, url, rel: 'next', aria: { label: "次のページ" }, remote: remote %>
</span>
