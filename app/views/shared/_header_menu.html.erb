<button
  type="button"
  class="header-menu__toggle flex size-11 shrink-0 flex-col items-center justify-center gap-1.5 rounded-lg hover:opacity-60"
  data-action="click->hamburger-menu#toggle"
  data-hamburger-menu-target="button"
  aria-label="メニューを開く"
  aria-expanded="false"
  aria-controls="header-menu"
>
  <span class="header-menu__toggle-line block h-0.5 w-7 rounded-full bg-dark-blue"></span>
  <span class="header-menu__toggle-line block h-0.5 w-7 rounded-full bg-dark-blue"></span>
  <span class="header-menu__toggle-line block h-0.5 w-7 rounded-full bg-dark-blue"></span>
</button>
<div id="header-menu" class="header-menu absolute right-4 top-full z-50 hidden sm:right-6 lg:right-8" data-hamburger-menu-target="menu">
  <nav aria-label="メインナビゲーション" class="header-menu__navigation w-52 rounded-xl border border-gray-200 bg-white p-2 text-base shadow-2xl">
    <ul class="header-menu__list flex flex-col gap-1">
      <li class="header-menu__item">
        <%= link_to root_path, class: "header-menu__link flex min-h-11 w-full items-center gap-3 rounded-lg px-3 py-2 text-dark-blue hover:bg-dawn-mist" do %>
          <i class="fa-solid fa-house w-5 text-center" aria-hidden="true"></i>
          ホーム
        <% end %>
      </li>
      <li class="header-menu__item">
        <%= link_to new_situation_path, class: "header-menu__link flex min-h-11 w-full items-center gap-3 rounded-lg px-3 py-2 text-dark-blue hover:bg-dawn-mist" do %>
          <i class="fa-solid fa-plus w-5 text-center" aria-hidden="true"></i>
          新しくふりかえる
        <% end %>
      </li>
      <li class="header-menu__item">
        <%= link_to situations_path, class: "header-menu__link flex min-h-11 w-full items-center gap-3 rounded-lg px-3 py-2 text-dark-blue hover:bg-dawn-mist" do %>
          <i class="fa-solid fa-list w-5 text-center" aria-hidden="true"></i>
          履歴一覧
        <% end %>
      </li>
      <li class="header-menu__item header-menu__item--separated mt-2 border-t border-gray-200 pt-2">
        <%= link_to logout_path, data: { turbo_method: :delete }, class: "header-menu__link flex min-h-11 w-full items-center gap-3 rounded-lg px-3 py-2 text-dark-blue hover:bg-dawn-mist" do %>
          <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center" aria-hidden="true"></i>
          ログアウト
        <% end %>
      </li>
      <li class="header-menu__item header-menu__item--danger mt-2 border-t border-gray-200 pt-2">
        <%= button_to user_path, method: :delete, form: { class: "header-menu__withdrawal-form w-full", data: { turbo_confirm: "本当に退会しますか？すべての状況整理とタスクが削除され、この操作は取り消せません。" } }, class: "header-menu__withdrawal-button flex min-h-11 w-full items-center gap-3 rounded-lg px-3 py-2 text-left text-red-700 hover:bg-red-50" do %>
          <i class="fa-solid fa-user-slash w-5 text-center" aria-hidden="true"></i>
          退会する
        <% end %>
      </li>
    </ul>
  </nav>
</div>
