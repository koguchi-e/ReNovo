<button
  type="button"
  class="flex size-11 shrink-0 flex-col items-center justify-center gap-1.5 rounded-lg hover:opacity-60"
  data-action="click->hamburger-menu#toggle"
  data-hamburger-menu-target="button"
  aria-label="メニューを開く"
  aria-expanded="false"
  aria-controls="header-menu"
>
  <span class="block h-0.5 w-7 rounded-full bg-dark-blue"></span>
  <span class="block h-0.5 w-7 rounded-full bg-dark-blue"></span>
  <span class="block h-0.5 w-7 rounded-full bg-dark-blue"></span>
</button>
<div id="header-menu" class="absolute right-4 top-full z-50 hidden sm:right-6 lg:right-8" data-hamburger-menu-target="menu">
  <nav class="w-40 bg-white rounded-md text-lg flex flex-col gap-3 p-3 shadow-2xl">
    <div>
      <%= link_to root_path, class: "text-dark-blue hover:opacity-60" do %>
        <i class="fa-solid fa-house" aria-hidden="true"></i>
        ホーム
      <% end %>
    </div>
    <div>
      <%= link_to new_situation_path, class: "text-dark-blue hover:opacity-60" do %>
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        新規
      <% end %>
    </div>
    <div>
      <%= link_to situations_path, class: "text-dark-blue hover:opacity-60" do %>
        <i class="fa-solid fa-list" aria-hidden="true"></i>
        一覧
      <% end %>
    </div>
    <div>
      <%= link_to logout_path, data: { turbo_method: :delete }, class: "text-dark-blue hover:opacity-60" do %>
        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
        ログアウト
      <% end %>
    </div>
    <div>
      <%= button_to user_path, method: :delete, form: { data: { turbo_confirm: "本当に退会しますか？すべてのふりかえりとタスクが削除され、この操作は取り消せません。" } }, class: "text-dark-blue hover:opacity-60" do %>
        <i class="fa-solid fa-user-slash" aria-hidden="true"></i>
        退会する
      <% end %>
    </div>
  </nav>
</div>
