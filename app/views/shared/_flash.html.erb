<% if type.to_sym == :notice %>
  <div data-controller="flash" class="flash-message flash-message--notice mt-3 pointer-events-auto w-[min(300px,calc(100vw-2rem))] rounded border border-calm-blue/40 bg-blue-50 px-4 py-3 text-dark-blue shadow-md transition-opacity duration-[3000ms] ease-linear" role="status" aria-live="polite">
    <p class="flash-message__text w-full"><%= message %></p>
  </div>
<% else %>
  <div class="flash-message flash-message--alert mt-3 pointer-events-auto w-[min(300px,calc(100vw-2rem))] rounded border border-red-700 bg-red-200 px-4 py-3 text-red-700 shadow-md transition-opacity duration-[3000ms] ease-linear" role="alert">
    <p class="flash-message__text w-full"><%= message %></p>
  </div>
<% end %>
