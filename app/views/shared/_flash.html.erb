<% if type.to_sym == :notice %>
  <div data-controller="flash" class="absolute top-20 right-20 z-50 w-[300px] rounded border border-green-700 bg-green-200 px-4 py-3 text-green-700 transition-opacity duration-[3000ms] ease-linear" role="status" aria-live="polite">
    <%= message %>
  </div>
<% else %>
  <div data-controller="flash" class="absolute top-20 right-20 z-50 w-[300px] rounded border border-red-700 bg-red-200 px-4 py-3 text-red-700 transition-opacity duration-[3000ms] ease-linear" role="alert">
    <%= message %>
  </div>
<% end %>
