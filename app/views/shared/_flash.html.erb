<% if type.to_sym == :notice %>
  <div data-controller="flash" class="pointer-events-auto w-[min(300px,calc(100vw-2rem))] rounded border border-green-700 bg-green-200 px-4 py-3 text-green-700 shadow-md transition-opacity duration-[3000ms] ease-linear" role="status" aria-live="polite">
    <p class="w-full"><%= message %></p>
  </div>
<% else %>
  <div data-controller="flash" class="pointer-events-auto w-[min(300px,calc(100vw-2rem))] rounded border border-red-700 bg-red-200 px-4 py-3 text-red-700 shadow-md transition-opacity duration-[3000ms] ease-linear" role="alert">
    <p class="w-full"><%= message %></p>
  </div>
<% end %>
