<header
  class="relative w-full border-b border-gray-200 bg-dawn-mist"
  <% if current_user && !content_for?(:simple_header) %>
    data-controller="hamburger-menu"
    data-action="click@window->hamburger-menu#closeOnOutside keydown.esc@window->hamburger-menu#closeOnEscape"
<% end %>>
<div class="page-container relative flex items-center justify-between py-3">
  <%= link_to root_path, class: "inline-flex items-center gap-0.5 text-dark-blue hover:opacity-70", aria: { label: "ReNovo ホーム" } do %>
    <%= image_tag "brand-symbol.png", alt: "", class: "size-11 shrink-0" %>
    <%= image_tag "renovo-wordmark.svg", alt: "ReNovo", class: "h-auto w-28" %>
  <% end %>
  <% if current_user && !content_for?(:simple_header) %>
    <%= render "shared/header_menu" %>
  <% end %>
</div>
</header>
