<footer class="site-footer bg-dawn-mist px-4 py-6 border-t border-gray-200 text-dark-blue text-lg">
  <div class="site-footer__inner mx-auto flex w-full max-w-5xl flex-col items-center gap-4">
    <nav class="site-footer__navigation text-sm" aria-label="フッターナビゲーション">
      <ul class="site-footer__link-list flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
        <li class="site-footer__link-item">
          <%= link_to "利用規約", terms_path, class: "site-footer__link inline-flex min-h-10 items-center px-1 hover:opacity-70" %>
        </li>
        <li class="site-footer__link-item">
          <%= link_to "プライバシーポリシー", privacy_path, class: "site-footer__link inline-flex min-h-10 items-center px-1 hover:opacity-70" %>
        </li>
        <li class="site-footer__link-item">
          <%= link_to "お問い合わせ", "https://forms.gle/EiqNdo63jMkgaWJeA", target: "_blank", rel: "noopener noreferrer", class: "site-footer__link inline-flex min-h-10 items-center px-1 hover:opacity-70" %>
        </li>
      </ul>
    </nav>
    <p class="site-footer__copyright flex items-center gap-2">
      <%= link_to "https://github.com/koguchi-e/ReNovo", target: "_blank", rel: "noopener noreferrer", class: "site-footer__github-link text-xl leading-none hover:opacity-60", aria: { label: "ReNovoのGitHubリポジトリ" } do %>
        <i class="fa-brands fa-github" aria-hidden="true"></i>
      <% end %>
      &copy; 2026
      <%= link_to "ReNovo", root_path, class: "site-footer__home-link hover:opacity-60" %>
    </p>
  </div>
</footer>
