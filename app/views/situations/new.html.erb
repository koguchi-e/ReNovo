<% content_for :title, "新しくふりかえる | ReNovo" %>
<% content_for :description, "現在の状況や悩み、目標を整理して、取り組みやすいタスクを作成します。" %>

<article aria-labelledby="situation-page-heading">
  <div>
    <h1 id="situation-page-heading" class="flex items-center justify-center gap-3 text-4xl font-bold text-dark-blue">
      <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
      <span>新しくふりかえる</span>
    </h1>
    <p class="mt-5 text-center text-xl text-calm-blue">
      3つの質問に答えて現在の状況を整理します。
    </p>
  </div>
  <section class="mt-6" aria-label="状況整理の入力">
    <% if @usage_limit_reached %>
      <%= render "usage_limit_reached" %>
    <% else %>
      <%= render "form", situation: @situation %>
    <% end %>
  </section>
</article>
