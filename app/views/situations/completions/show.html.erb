<div class="flex">
  <svg class="size-15" viewBox="0 0 100 100" aria-hidden="true">
    <circle
      class="completion-circle stroke-calm-blue"
      cx="50"
      cy="50"
      r="42"
      fill="none"
      stroke-width="6"
      stroke-linecap="round"
    />

    <path
      class="completion-check stroke-calm-blue"
      d="M28 52 L43 67 L73 35"
      fill="none"
      stroke-width="7"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <h1 class="mt-3 ml-3 text-3xl font-bold text-dark-blue">
    タスクの整理が完了しました！
  </h1>
</div>
<div class="mt-3 flex flex-col items-start gap-3">
  <div class="mt-5 w-full rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
    <h2 class="text-2xl font-bold text-dark-blue">
      <i class="fa-solid fa-play" aria-hidden="true"></i>
      最初に取り組むタスク
    </h2>
    <hr class="mt-3 mb-5 border border-gray-200">
    <span class="text-calm-blue font-bold text-2xl"><%= @first_task.content %></span>
  </div>
  <%= render "tasks/code_block", tasks: @tasks, situation: @situation, new_task: @new_task %>
</div>
<div class="mt-8 flex flex-col items-center gap-3">
  <%= render "/situations/review_modal", situation: @situation %>
  <%= link_to new_situation_path, class: "bg-calm-blue hover:opacity-60 text-white font-bold py-2 px-4 rounded" do %>
    <i class="fa-solid fa-plus" aria-hidden="true"></i>
    新しくふりかえる
  <% end %>
</div>
