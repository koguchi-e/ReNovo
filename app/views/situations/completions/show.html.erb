<div class="flex">
  <svg class="size-15" viewBox="0 0 100 100" aria-hidden="true">
    <circle
      class="completion-circle stroke-dusty-denim"
      cx="50"
      cy="50"
      r="42"
      fill="none"
      stroke-width="6"
      stroke-linecap="round"
    />

    <path
      class="completion-check stroke-dusty-denim"
      d="M28 52 L43 67 L73 35"
      fill="none"
      stroke-width="7"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <h2 class="mt-3 ml-3 text-3xl font-bold text-dusk-blue">
    タスクの整理が完了しました！
  </h2>
</div>
<div class="mt-3 pl-8 flex flex-col items-start gap-3">
  <div class="mt-5 p-10 container bg-white border-2 border-gray-200 rounded">
    <h2 class="text-2xl font-bold text-dusk-blue">
      <i class="fa-solid fa-play"></i>
      最初にやること
    </h2>
    <hr class="mt-3 mb-5 border-1 border-gray-200">
    <span class="text-dusty-denim pl-9 font-bold text-2xl"><%= @first_task.content %></span>
  </div>
  <%= render "tasks/code_block", tasks: @tasks, situation: @situation, new_task: @new_task %>
</div>
<div class="m-8 flex flex-col items-start gap-3">
  <%= render "/situations/review_modal", situation: @situation %>
  <%= link_to new_situation_path, class: "bg-dusty-denim hover:opacity-60 text-white font-bold py-2 px-4 rounded" do %>
    <i class="fa-solid fa-plus"></i>
    新しくふりかえる
  <% end %>
</div>
