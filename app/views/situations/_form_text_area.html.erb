<% input_id = f.field_id(attribute) %>
<% count_id = "#{input_id}_count" %>
<% error_id = "#{input_id}_error" %>

<%= f.label attribute, label_text, class: "sr-only" %>

<%= f.text_area attribute,
  id: input_id,
  placeholder: placeholder_text,
  class: "h-50 w-full appearance-none rounded border-2 border-gray-200 bg-gray-200 leading-tight text-gray-700 focus:border-bright-orange focus:bg-white focus:outline-none",
  aria: {
    describedby: "#{count_id} #{error_id}"
  },
  data: {
    situation_form_target: "input",
    action: "input->situation-form#clearError input->situation-form#count"
  } %>

<p id="<%= count_id %>" class="text-dark-blue mt-1 text-right text-sm text-dark-blue">
  文字数： <span data-situation-form-target="output">0</span> / 300文字
</p>

<p
  id="<%= error_id %>"
  class="hidden text-red-600 font-bold"
  data-situation-form-target="error"
  aria-live="polite"></p>
