<% input_id = f.field_id(attribute) %>
<% count_id = "#{input_id}_count" %>
<% error_id = "#{input_id}_error" %>

<%= f.label attribute, label_text, class: "situation-form__field-label sr-only" %>

<%= f.text_area attribute,
  id: input_id,
  placeholder: placeholder_text,
  class: "situation-form__textarea h-50 w-full appearance-none resize-y rounded-lg border border-gray-300 bg-white px-4 py-3 leading-relaxed text-gray-700 shadow-inner placeholder:text-slate-400 focus:border-bright-orange focus:outline-none focus:ring-2 focus:ring-bright-orange/20",
  aria: {
    describedby: "#{count_id} #{error_id}"
  },
  data: {
    situation_form_target: "input",
    action: "input->situation-form#clearError input->situation-form#count"
  } %>

<p id="<%= count_id %>" class="situation-form__character-count mt-1 text-right text-sm text-dark-blue">
  文字数： <span class="situation-form__character-count-value" data-situation-form-target="output">0</span> / 300文字
</p>

<p
  id="<%= error_id %>"
  class="situation-form__field-error hidden font-bold text-muted-error"
  data-situation-form-target="error"
  aria-live="polite"></p>
