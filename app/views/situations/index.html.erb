<% content_for :title, "状況整理一覧 | ReNovo" %>
<% content_for :description, "これまでに作成した状況整理とタスクリストを確認できます。" %>

<article class="situation-history" aria-labelledby="situation-history-heading">
  <%= render "shared/page_header",
    block_name: "situation-history",
    heading_id: "situation-history-heading",
    heading_size: "text-4xl",
    icon_class: "fa-solid fa-list",
    title: "状況整理一覧",
    description: "過去に作成した状況整理を見直しましょう" %>

  <section class="situation-history__content page-content mt-5" aria-label="状況整理の一覧">
  <% if @situations.total_count.positive? %>
    <ul class="situation-history__list">
      <% @situations.each do |situation| %>
        <li class="situation-history__item">
          <%= link_to situation_path(situation.id),
            class: "situation-history__link my-3 block rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-calm-blue focus-visible:ring-offset-2 focus-visible:ring-offset-dawn-mist" do %>
            <article class="situation-history__card relative rounded-2xl border border-gray-200 bg-white p-4 text-dark-blue shadow-sm transition-shadow hover:border-calm-blue hover:shadow-md sm:p-5">
              <time datetime="<%= situation.created_at.iso8601 %>" class="situation-history__date text-sm">
                <%= situation.created_at.strftime('%Y年%m月%d日 %H時%M分') %>
              </time>
              <hr class="situation-history__divider mt-3 border border-gray-200">
              <p class="situation-history__summary mt-2 block text-lg font-bold">
                <%= situation.fact %>
              </p>
            </article>
          <% end %>
        </li>
      <% end %>
    </ul>

    <%= paginate @situations %>
  <% else %>
    <%= render "empty" %>
  <% end %>
  </section>
</article>
