<% content_for :title, "状況整理の履歴 | ReNovo" %>
<% content_for :description, "これまでの状況整理で入力した内容とタスクリストを確認できます。" %>

<div>
  <h1 class="text-center text-4xl font-bold text-dark-blue">
    <i class="fa-solid fa-list" aria-hidden="true"></i>
    状況整理の履歴
  </h1>

  <% if @situations.total_count.positive? %>
    <p class="mt-5 text-center text-xl text-calm-blue">過去に作成したタスクリストを見直しましょう</p>
    <ul>
      <% @situations.each do |situation| %>
        <li>
          <%= link_to situation_path(situation.id),
            class: "m-3 block rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-calm-blue focus-visible:ring-offset-2 focus-visible:ring-offset-dawn-mist" do %>
            <div class="relative rounded-2xl border border-gray-200 bg-white p-4 text-dark-blue shadow-sm transition hover:border-calm-blue hover:shadow-md sm:p-5">
              <time datetime="<%= situation.created_at.iso8601 %>" class="text-sm">
                <%= situation.created_at.strftime('%Y年%m月%d日 %H時%M分') %>
              </time>
              <hr class="mt-3 border border-gray-200">
              <p class="mt-2 block text-lg font-bold">
                <%= situation.fact %>
              </p>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>

    <%= paginate @situations %>
  <% else %>
    <%= render "empty" %>
  <% end %>
</div>
