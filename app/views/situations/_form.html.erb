<div class="mx-auto w-full max-w-2xl" data-controller="situation-form">
  <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
    <ul class="mx-auto mb-10 flex w-3/4 flex-row">
      <li class="basis-0 flex-1">
        <div class="flex w-full items-start text-xs">
          <div class="flex shrink-0 flex-col items-center">
            <span
              class="flex size-7 items-center justify-center rounded-full bg-gray-200 text-gray-700 font-medium"
              data-situation-form-target="progressStep">
              1
            </span>
            <span class="mt-1 whitespace-nowrap text-center text-gray-600" data-situation-form-target="progressLabel">出来事</span>
          </div>
          <div class="ms-2 mt-3 h-px flex-1 bg-gray-200"></div>
        </div>
      </li>
      <li class="basis-0 flex-1">
        <div class="flex w-full items-start text-xs">
          <div class="flex shrink-0 flex-col items-center">
            <span
              class="flex size-7 items-center justify-center rounded-full bg-gray-200 text-gray-700 font-medium"
              data-situation-form-target="progressStep">
              2
            </span>
            <span class="mt-1 whitespace-nowrap text-center text-gray-600" data-situation-form-target="progressLabel">問題</span>
          </div>
          <div class="ms-2 mt-3 h-px flex-1 bg-gray-200"></div>
        </div>
      </li>
      <li class="shrink-0">
        <div class="flex flex-col items-center text-xs">
          <span
            class="flex size-7 items-center justify-center rounded-full bg-gray-200 text-gray-700 font-medium"
            data-situation-form-target="progressStep">
            3
          </span>
          <span class="mt-1 whitespace-nowrap text-center text-gray-600" data-situation-form-target="progressLabel">目標</span>
        </div>
      </li>
    </ul>
    <%= form_with model: situation, data: { action: "submit->situation-form#submit" } do |f| %>
      <div data-situation-form-target="step" class="block">
        <div class="text-center">
          <span class="mb-3 inline-block border-b-2 border-dark-blue px-1 pb-1 text-sm font-bold text-dark-blue">質問1</span>
          <h2 tabindex="-1" data-situation-form-target="heading" class="text-2xl font-bold leading-tight text-dark-blue sm:text-3xl">
            今どんなことが起きていますか？
          </h2>
          <p class="mx-auto mt-4 max-w-xl leading-relaxed text-calm-blue">
            現在の状況や、起きた出来事を具体的に書き出してみましょう。
          </p>
        </div>
        <div class="mb-5 mt-6 rounded-xl border border-gray-200 px-4 py-3">
          <p class="text-sm font-bold text-dark-blue">入力例</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-xs leading-relaxed text-slate-500">
            <li>「ビジネスメールが書けていない」と上司に指摘された</li>
            <li>勉強したいのにずっとSNSを見てしまう</li>
            <li>やりたいことがあるのに疲れて何も始められない</li>
          </ul>
        </div>
        <%= render "form_text_area",
          f: f,
          attribute: :fact,
          label_text: "現在の状況や起きた出来事",
          placeholder_text: "例：勉強したいのに、ずっとSNSを見てしまう" %>
        <%= render "input_notice" %>
        <div class="mt-6 flex justify-end">
          <button type="button" data-testid="fact-next-button" data-action="click->situation-form#next" class="primary-button">
            次へ
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div data-situation-form-target="step" class="block">
        <div class="text-center">
          <span class="mb-3 inline-block border-b-2 border-dark-blue px-1 pb-1 text-sm font-bold text-dark-blue">質問2</span>
        </div>
        <h2 tabindex="-1" data-situation-form-target="heading" class="text-center text-2xl font-bold leading-tight text-dark-blue sm:text-3xl">
          今一番困っていることは何ですか？
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-center leading-relaxed text-calm-blue">
          一番モヤモヤしていることや、気になっていることを書き出してみましょう。
        </p>
        <div class="mb-5 mt-6 rounded-xl border border-gray-200 px-4 py-3">
          <p class="text-sm font-bold text-dark-blue">入力例</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-xs leading-relaxed text-slate-500">
            <li>メールのどこが悪いのか分からず修正できない</li>
            <li>周りが気になって自分の作業に集中できない</li>
            <li>情報を集めすぎて動けなくなっている</li>
          </ul>
        </div>
        <%= render "form_text_area",
          f: f,
          attribute: :problem,
          label_text: "今一番困っていること",
          placeholder_text: "例：情報を集めすぎて、何から始めればよいか分からない" %>
        <div class="mt-6 flex items-center justify-between gap-3">
          <button type="button" data-action="click->situation-form#prev" class="secondary-button">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            戻る
          </button>
          <button type="button" data-testid="problem-next-button" data-action="click->situation-form#next" class="primary-button">
            次へ
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <div data-situation-form-target="step" class="block">
        <div class="text-center">
          <span class="mb-3 inline-block border-b-2 border-dark-blue px-1 pb-1 text-sm font-bold text-dark-blue">質問3</span>
        </div>
        <h2 tabindex="-1" data-situation-form-target="heading" class="text-center text-2xl font-bold leading-tight text-dark-blue sm:text-3xl">
          どうなったら、<br class="hidden sm:block">少し前に進めそうですか？
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-center leading-relaxed text-calm-blue">
          将来的にどのような状態になっていたいか、理想の状態を書き出してみましょう。
        </p>
        <div class="mb-5 mt-6 rounded-xl border border-gray-200 px-4 py-3">
          <p class="text-sm font-bold text-dark-blue">入力例</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-xs leading-relaxed text-slate-500">
            <li>メールを修正して、次回は自分で書けるようになりたい</li>
            <li>SNSを見る時間を減らして、少しでも作業を進めたい</li>
            <li>自分の作業に集中できるようになりたい</li>
          </ul>
        </div>
        <%= render "form_text_area",
          f: f,
          attribute: :goal,
          label_text: "目指したい状態",
          placeholder_text: "例：SNSを見る時間を減らして、少しでも作業を進めたい" %>
        <div class="mt-6 flex items-center justify-between gap-3">
          <button type="button" data-action="click->situation-form#prev" class="secondary-button">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            戻る
          </button>
          <%= f.button type: "submit", class: "primary-button" do %>
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            タスクを作成する
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
