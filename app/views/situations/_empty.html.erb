<div class="mx-auto mt-12 flex w-full max-w-xl flex-col items-center rounded-2xl border border-gray-200 bg-white px-6 py-12 text-center shadow-sm">
  <div class="flex size-16 items-center justify-center rounded-full bg-blue-50 text-2xl text-calm-blue">
    <i class="fa-solid fa-list" aria-hidden="true"></i>
  </div>
  <h2 class="mt-8 text-2xl font-bold text-dark-blue">
    ふりかえりはまだありません。
  </h2>
  <div class="mt-3 gap-3">
    <%= link_to new_situation_path, class: "mt-10 inline-flex items-center justify-center gap-3 rounded-lg bg-calm-blue px-6 py-4 text-xl font-bold text-white hover:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-calm-blue focus-visible:ring-offset-2 focus-visible:ring-offset-dawn-mist" do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
      新しくふりかえる
    <% end %>
  </div>
</div>
