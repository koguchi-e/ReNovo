<div class="review-modal flex flex-col items-center <%= "w-full max-w-xs" if local_assigns[:full_width] %>" data-controller="modal">
  <button type="button" class="review-modal__open-button action-button action-button--secondary action-button--standard" data-action="modal#open">
    <i class="fa-solid fa-list-check" aria-hidden="true"></i>
    状況整理の内容を確認
  </button>

  <dialog aria-labelledby="review-modal-title" data-modal-target="dialog" data-action="click->modal#closeOnBackdrop" class="review-modal__dialog m-auto w-full max-w-2xl rounded-lg bg-white p-6 pb-4 text-left shadow-xl backdrop:bg-slate-900/50">
    <section class="review-modal__content container mx-auto bg-white pb-5">
      <h2 id="review-modal-title" class="review-modal__heading text-2xl font-bold text-dark-blue">
        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
        状況整理の内容
      </h2>
      <hr class="review-modal__divider mt-3 border border-gray-200">
      <dl class="review-modal__response-list">
        <%= render "/situations/situation_attribute", situation: situation, attribute: :fact %>
        <%= render "/situations/situation_attribute", situation: situation, attribute: :problem %>
        <%= render "/situations/situation_attribute", situation: situation, attribute: :goal %>
      </dl>

      <button type="button" class="review-modal__close-button action-button action-button--secondary action-button--standard mt-5" data-action="modal#close">
        閉じる
      </button>
    </section>
  </dialog>
</div>
