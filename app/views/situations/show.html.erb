<% content_for :title, "状況整理の詳細 | ReNovo" %>
<% content_for :description, "過去に入力した内容と、作成したタスクリストを確認できます。" %>

<div>
  <div class="mb-5 flex flex-col items-start">
    <%= link_to situations_path, class: "text-dark-blue hover:opacity-60" do %>
      <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      状況整理の履歴に戻る
    <% end %>
  </div>
  <div>
    <h1 class="text-center text-4xl font-bold text-dark-blue">
      <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
      状況整理の詳細
    </h1>
    <hr class="mt-3 border border-gray-200">
    <time datetime="<%= @situation.created_at.iso8601 %>" class="mt-5 block text-center text-xl text-calm-blue">
      <%= @situation.created_at.strftime('%Y年%m月%d日 %H時%M分') %>
    </time>
  </div>
  <div class="mt-3 flex flex-col items-start gap-3">
    <div class="mt-5 w-full rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold text-dark-blue">
        <i class="fa-solid fa-flag" aria-hidden="true"></i>
        最初に取り組むタスク
      </h2>
      <hr class="mt-3 mb-5 border border-gray-200">
      <span class="text-calm-blue font-bold text-2xl"><%= @first_task.content %></span>
    </div>
  </div>
  <%= render "tasks/code_block", tasks: @tasks, situation: @situation, new_task: @new_task %>
  <div class="mt-5 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
    <h2 class="text-2xl font-bold text-dark-blue">
      <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
      入力内容の確認
    </h2>
    <hr class="mt-3 border border-gray-200">
    <dl>
      <%= render "situation_attribute", situation: @situation, attribute: :fact %>
      <%= render "situation_attribute", situation: @situation, attribute: :problem %>
      <%= render "situation_attribute", situation: @situation, attribute: :goal %>
    </dl>
  </div>
</div>
