<% content_for :title, "状況整理の詳細 | ReNovo" %>
<% content_for :description, "過去に入力した内容と、作成したタスクリストを確認できます。" %>

<article class="situation-detail" aria-labelledby="situation-detail-heading">
  <%= render "shared/page_header",
    block_name: "situation-detail",
    heading_id: "situation-detail-heading",
    heading_size: "text-4xl",
    icon_class: "fa-solid fa-file-lines",
    title: "状況整理の詳細",
    description: "状況整理の内容と、作成したタスクを確認できます。",
    metadata: tag.time("作成日時: #{@situation.created_at.strftime('%Y年%m月%d日 %H時%M分')}", datetime: @situation.created_at.iso8601, class: "situation-detail__date mt-5 block text-center text-base text-calm-blue") %>
  <section class="situation-detail__content page-content mt-5" aria-label="状況整理の詳細内容">
    <% if @show_completion_message %>
      <button type="button" class="situation-detail__completion-message mb-6 flex w-full items-center justify-center gap-4 rounded-xl border border-calm-blue/30 bg-blue-50 px-5 py-4 text-base font-bold text-dark-blue shadow-sm hover:opacity-70" data-controller="dismissible" data-action="dismissible#dismiss" aria-label="タスク整理完了メッセージを閉じる">
        <svg class="situation-detail__completion-icon size-11 shrink-0" viewBox="0 0 100 100" aria-hidden="true">
          <circle class="completion-circle stroke-calm-blue" cx="50" cy="50" r="42" fill="none" stroke-width="6" stroke-linecap="round" />
          <path class="completion-check stroke-calm-blue" d="M28 52 L43 67 L73 35" fill="none" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="situation-detail__completion-message-text">タスクの整理が完了しました！</span>
      </button>
    <% end %>
    <%= render "tasks/first_task", tasks: @tasks %>
    <%= render "tasks/code_block", tasks: @tasks, situation: @situation %>
    <section class="situation-detail__responses mt-5 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="situation-responses-heading">
    <h2 id="situation-responses-heading" class="situation-detail__responses-heading text-2xl font-bold text-dark-blue">
      <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
      状況整理の内容
    </h2>
    <hr class="situation-detail__responses-divider mt-3 border border-gray-200">
    <dl class="situation-detail__response-list">
      <%= render "situation_attribute", situation: @situation, attribute: :fact %>
      <%= render "situation_attribute", situation: @situation, attribute: :problem %>
      <%= render "situation_attribute", situation: @situation, attribute: :goal %>
    </dl>
    </section>
  </section>
  <nav class="situation-detail__footer-navigation mt-8 flex w-full justify-center" aria-label="状況整理一覧への移動">
    <%= link_to situations_path, class: "action-button action-button--secondary action-button--standard" do %>
      <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      状況整理一覧に戻る
    <% end %>
  </nav>
</article>
