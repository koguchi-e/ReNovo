<h1 class="text-center text-4xl font-bold text-dark-blue">
  <i class="fa-solid fa-sort" aria-hidden="true"></i>
  タスクを並べ替える
</h1>
<p class="mt-5 text-center text-xl text-calm-blue">
  ドラッグすると、並び順が自動で保存されます。
</p>
<div data-controller="task-order" class="mt-5">
  <% @tasks.each do |task| %>
    <div data-task-id="<%= task.id %>" data-task-position-url="<%= situation_position_path(@situation) %>" 
    class="relative m-5 rounded-2xl border border-gray-200 bg-white p-5 text-dark-blue shadow-sm hover:-translate-y-1 hover:scale-[1.02] sm:p-8">
      <span class="js-grab cursor-grab">
        <i class="fa-solid fa-grip" aria-hidden="true"></i>
      </span>
      <%= task.content %>
    </div>
  <% end %>
</div>
<div class="m-5 flex justify-center">
  <%= render "/situations/review_modal", situation: @situation %>
</div>
<div class="m-5 flex items-center justify-between gap-3">
  <%= link_to situation_tasks_path(@situation), class: "border border-calm-blue bg-white text-calm-blue hover:opacity-60 font-bold py-2 px-4 rounded" do %>
    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
    戻る
  <% end %>
  <%= link_to situation_completion_path(@situation), class: "bg-calm-blue hover:opacity-60 text-white font-bold py-2 px-4 rounded" do %>
    <i class="fa-solid fa-check" aria-hidden="true"></i>
    完了
  <% end %>
</div>
