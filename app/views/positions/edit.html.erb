<% content_for :title, "タスクの並べ替え | ReNovo" %>
<% content_for :description, "作成したタスクを取り組みやすい順番に並べ替えます。" %>

<h1 class="text-center text-4xl font-bold text-dark-blue">
  <i class="fa-solid fa-sort" aria-hidden="true"></i>
  タスクを並べ替える
</h1>
<p class="mt-5 text-center text-xl text-calm-blue">
  ドラッグまたは上下ボタンでタスクを並べ替えられます。<br>
  並び順は自動で保存されます。
</p>
<ul data-controller="task-order" class="mt-5">
  <% @tasks.each do |task| %>
    <li data-task-id="<%= task.id %>" data-task-position-url="<%= situation_position_path(@situation) %>"
    class="relative m-5 flex items-center gap-3 rounded-2xl border border-gray-200 bg-white p-5 text-dark-blue shadow-sm sm:p-8">
      <span class="js-grab shrink-0 cursor-grab">
        <i class="fa-solid fa-grip" aria-hidden="true"></i>
      </span>
      <div class="flex flex-1 flex-col items-start justify-center gap-2 self-stretch sm:flex-row sm:items-center sm:gap-3" data-task-order-target="content">
        <% if task.position == 1 %>
          <span class="inline-flex shrink-0 rounded-full bg-blue-50 px-3 py-1 text-sm font-bold text-calm-blue" data-task-order-target="recommendation">
            <i class="fa-solid fa-flag" aria-hidden="true"></i>
            最初に取り組むタスク
          </span>
        <% end %>
        <span><%= task.content %></span>
      </div>
      <div class="ml-auto flex shrink-0 items-center gap-2">
        <button type="button" data-action="task-order#moveUp" class="icon-button text-sm" aria-label="<%= "#{task.content}を上へ移動" %>">
          <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
        </button>
        <button type="button" data-action="task-order#moveDown" class="icon-button text-sm" aria-label="<%= "#{task.content}を下へ移動" %>">
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
      </div>
    </li>
  <% end %>
</ul>
<div class="m-5 flex justify-center">
  <%= render "/situations/review_modal", situation: @situation %>
</div>
<div class="m-5 flex items-center justify-between gap-3">
  <%= link_to situation_tasks_path(@situation), class: "secondary-button" do %>
    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
    戻る
  <% end %>
  <%= link_to situation_completion_path(@situation), class: "primary-button" do %>
    <i class="fa-solid fa-check" aria-hidden="true"></i>
    完了
  <% end %>
</div>
