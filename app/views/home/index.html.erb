<% content_for :title, "ReNovo | 考えすぎて動けない人のためのタスク作成サービス" %>
<% content_for :description, "ReNovoは、状況や悩み、目標を整理し、今取り組める小さなタスクをAIが提案するサービスです。" %>
<section class="flex w-full flex-col items-center gap-6">
  <div class="text-center">
    <div class="mx-auto flex w-full max-w-[220px] flex-col items-center sm:max-w-[260px]" aria-hidden="true">
      <%= image_tag "brand-symbol.png", alt: "", class: "h-auto w-3/4" %>
      <%= image_tag "renovo-wordmark.svg", alt: "", class: "mt-2 h-auto w-full" %>
    </div>
    <h1 class="mt-5 text-3xl font-bold leading-tight text-dark-blue">
      「考えすぎて動けない」を、小さな一歩に変える。
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-calm-blue sm:text-lg">
      3つの質問に答えると、AIが今できる小さなタスクを提案します。
    </p>
    <div class="mt-6 flex justify-center">
      <%= render "call_to_action" %>
    </div>
  </div>
</section>
<section class="mt-8 w-full" aria-labelledby="usage-guide-heading">
  <hr class="mb-8 border-dashed border-gray-300">
  <div class="text-center">
    <h2 id="usage-guide-heading" class="text-2xl font-bold text-dark-blue sm:text-3xl">
      3ステップで、次の一歩へ
    </h2>
  </div>
  <ol class="mt-6 grid gap-4 md:grid-cols-3">
    <li class="rounded-xl border border-gray-200 bg-dawn-mist p-4 text-left">
      <div class="flex items-center justify-between">
        <span class="rounded-full bg-calm-blue px-3 py-1 text-sm font-bold text-white">STEP 1</span>
      </div>
      <h3 class="mt-3 text-lg font-bold text-dark-blue">3つの質問に答える</h3>
      <p class="mt-2 text-sm leading-relaxed text-calm-blue">今の状況、困りごと、少し前に進めそうな状態を整理します。</p>
      <div class="mt-3 flex h-44 items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
        <%= render "step_input_preview" %>
      </div>
    </li>
    <li class="rounded-xl border border-gray-200 bg-dawn-mist p-4 text-left">
      <div class="flex items-center justify-between">
        <span class="rounded-full bg-calm-blue px-3 py-1 text-sm font-bold text-white">STEP 2</span>
      </div>
      <h3 class="mt-3 text-lg font-bold text-dark-blue">提案されたタスクを確認する</h3>
      <p class="mt-2 text-sm leading-relaxed text-calm-blue">AIが作成したタスクを確認し、必要に応じて追加・編集します。</p>
      <div class="mt-3 flex h-44 items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
        <%= render "step_tasks_preview" %>
      </div>
    </li>
    <li class="rounded-xl border border-gray-200 bg-dawn-mist p-4 text-left">
      <div class="flex items-center justify-between">
        <span class="rounded-full bg-calm-blue px-3 py-1 text-sm font-bold text-white">STEP 3</span>
      </div>
      <h3 class="mt-3 text-lg font-bold text-dark-blue">タスクに取り掛かる</h3>
      <p class="mt-2 text-sm leading-relaxed text-calm-blue">整理したタスクから、今できる小さな一歩を始めます。</p>
      <div class="mt-3 flex h-44 items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
        <%= image_tag "step3@2x.png", alt: "作成したタスクに取り掛かる人のイラスト", class: "size-full object-contain" %>
      </div>
    </li>
  </ol>
</section>
<div class="mt-8">
  <%= render "call_to_action" %>
</div>
