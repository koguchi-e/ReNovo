<% content_for :title, "ReNovo | 考えすぎて動けない人のためのタスク作成サービス" %>
<% content_for :description, "ReNovoは、状況や悩み、目標を整理し、今取り組める小さなタスクをAIが提案するサービスです。" %>
<% content_for :hide_header, "true" %>

<header class="hero page-header w-full" aria-labelledby="hero-heading">
  <div class="hero__inner mx-auto max-w-4xl text-center">
    <div class="hero__brand inline-flex items-center gap-4 text-dark-blue">
      <%= image_tag "brand-symbol.png", alt: "", class: "hero__brand-symbol size-20 sm:size-24" %>
      <span class="hero__brand-name font-serif text-6xl leading-none tracking-tight sm:text-7xl">ReNovo</span>
    </div>
    <h1 id="hero-heading" class="hero__heading mt-6 text-center text-3xl font-bold leading-snug text-dark-blue sm:text-[2rem] lg:text-4xl">
      「考えすぎて動けない」を<br>小さな一歩に変える。
    </h1>
    <p class="hero__description mt-5 text-left text-lg leading-relaxed text-calm-blue sm:text-center sm:text-xl">
      3つの質問に答えるだけで、今のあなたにできる小さな一歩が見つかります。
    </p>
    <%= render "call_to_action", compact: true %>
    <p class="hero__supporting-text mt-3 text-sm text-slate-500">入力は約3分。作成後も自由に編集できます。</p>
  </div>
</header>

<div class="home-content page-content">
<section class="usage-guide mt-10 w-full border-t border-dashed border-gray-300 pt-8" aria-labelledby="usage-guide-heading">
  <header class="usage-guide__header text-center">
    <h2 id="usage-guide-heading" class="usage-guide__heading text-2xl font-bold text-dark-blue sm:text-3xl">
      3ステップで、次の一歩へ
    </h2>
  </header>
  <ol class="usage-guide__steps mt-[44px] grid gap-4 md:grid-cols-3">
    <li class="usage-guide__step relative rounded-2xl border border-gray-200 bg-dawn-mist p-4 pt-6 text-left">
      <span class="usage-guide__step-label absolute -top-3 left-4 rounded-full border border-calm-blue bg-[#fff] px-3 py-1 text-sm font-bold text-calm-blue">STEP 1</span>
      <h3 class="usage-guide__step-heading text-center text-lg font-bold text-dark-blue">状況を整理する</h3>
      <figure class="usage-guide__visual mt-4 aspect-square overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <%= image_tag "step-reflect.png", alt: "ノートに考えを書き出して整理する人", class: "usage-guide__image size-full scale-110 object-cover" %>
      </figure>
      <p class="usage-guide__step-description mt-3 text-sm leading-relaxed text-calm-blue">質問は3つだけ。今の状況を順番に整理します。</p>
    </li>
    <li class="usage-guide__step relative rounded-2xl border border-gray-200 bg-dawn-mist p-4 pt-6 text-left">
      <span class="usage-guide__step-label absolute -top-3 left-4 rounded-full border border-calm-blue bg-[#fff] px-3 py-1 text-sm font-bold text-calm-blue">STEP 2</span>
      <h3 class="usage-guide__step-heading text-center text-lg font-bold text-dark-blue">AIがタスクに分ける</h3>
      <figure class="usage-guide__visual mt-4 aspect-square overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <%= image_tag "step-generate.png", alt: "AIが考えを小さなタスクに分ける様子", class: "usage-guide__image size-full scale-110 object-cover" %>
      </figure>
      <p class="usage-guide__step-description mt-3 text-sm leading-relaxed text-calm-blue">取り組みやすい大きさのタスクをAIが提案します。</p>
    </li>
    <li class="usage-guide__step relative rounded-2xl border border-gray-200 bg-dawn-mist p-4 pt-6 text-left">
      <span class="usage-guide__step-label absolute -top-3 left-4 rounded-full border border-calm-blue bg-[#fff] px-3 py-1 text-sm font-bold text-calm-blue">STEP 3</span>
      <h3 class="usage-guide__step-heading text-center text-lg font-bold text-dark-blue">最初の一歩を選ぶ</h3>
      <figure class="usage-guide__visual mt-4 aspect-square overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <%= image_tag "step-act.png", alt: "最初のタスクを選んで行動を始める人", class: "usage-guide__image size-full scale-110 object-cover" %>
      </figure>
      <p class="usage-guide__step-description mt-3 text-sm leading-relaxed text-calm-blue">生成後も追加・編集・並べ替えができます。</p>
    </li>
  </ol>
</section>
<%= render "call_to_action" %>
</div>
