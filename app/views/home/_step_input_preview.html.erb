<div class="flex size-full flex-col p-3 text-dark-blue" aria-hidden="true">
  <div class="mx-auto flex w-4/5 items-start text-xs">
    <% ["出来事", "問題", "目標"].each_with_index do |label, index| %>
      <div class="flex min-w-0 flex-1 items-start last:flex-none">
        <div class="flex shrink-0 flex-col items-center">
          <span class="flex size-5 items-center justify-center rounded-full <%= index.zero? ? "bg-calm-blue text-white" : "bg-gray-200 text-gray-600" %>"><%= index + 1 %></span>
          <span class="mt-1 text-[9px] whitespace-nowrap text-gray-600"><%= label %></span>
        </div>
        <% unless index == 2 %>
          <span class="mx-2 mt-2.5 h-px flex-1 bg-gray-200"></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mt-2 text-center">
    <span class="border-b border-dark-blue text-[9px] font-bold">質問1</span>
    <p class="mt-1 text-sm font-bold leading-tight">今どんなことが起きていますか？</p>
  </div>

  <div class="mt-2 h-9 rounded border-2 border-gray-200 bg-gray-200 px-2 py-1 text-[9px] text-gray-500">
    今起きていることを入力
  </div>

  <span class="rounded bg-calm-blue items-center text-white mt-2 min-h-4 self-end gap-1 rounded px-2 py-1 text-[9px] leading-none">
    次へ
    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
  </span>
</div>
