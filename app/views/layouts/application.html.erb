<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ReNovo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Re Novo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag('favicon.ico') %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <script src="https://kit.fontawesome.com/54c0760265.js" crossorigin="anonymous"></script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col">
    <header class="relative w-full bg-dark-blue" data-controller="hamburger-menu">
      <div class="relative mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        <%= link_to "ReNovo", root_path, class: "text-xl font-bold text-bright-orange hover:opacity-60" %>
        <% if current_user %>
          <%= render "shared/header_menu" %>
        <% end %>
      </div>
    </header>
    <% if controller_name == "home" && action_name == "index" || controller_name == "terms" && action_name == "show" || controller_name == "privacy" && action_name == "show" %>
      <div class="flex-1 bg-calm-blue p-4 sm:p-8">
        <div class="mx-auto w-full max-w-5xl rounded-2xl bg-white p-4 shadow-sm sm:p-10">
          <main class="mx-auto flex w-full max-w-4xl flex-col items-center justify-center">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div id="flash_messages">
        <%= render "shared/flash", type: :notice, message: notice if notice.present? %>
        <%= render "shared/flash", type: :alert, message: alert if alert.present? %>
      </div>
      <main class="relative mx-auto mt-10 w-full max-w-3xl flex-1 px-4 pb-10 sm:px-6 lg:px-8">
        <%= yield %>
      </main>
    <% end %>
    <%= render "shared/footer" %>
  </body>
</html>
