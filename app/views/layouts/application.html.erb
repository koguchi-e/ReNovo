<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "ReNovo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Re Novo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= favicon_link_tag('favicon.ico') %>
    <%= favicon_link_tag "apple-touch-icon-180x180.png", rel: "apple-touch-icon", type: "image/png", sizes: "180x180" %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <script src="https://kit.fontawesome.com/54c0760265.js" crossorigin="anonymous"></script>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flex min-h-screen flex-col bg-dawn-mist">
    <header class="relative w-full border-b border-gray-200 bg-dawn-mist" data-controller="hamburger-menu">
      <div class="relative mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        <%= link_to root_path, class: "text-xl font-bold text-dark-blue hover:opacity-60" do %>
          <%= image_tag "logo.png", alt: "ReNovo ホーム", class: "h-auto w-full max-w-[180px]" %>
        <% end %>
        <% if current_user %>
          <%= render "shared/header_menu" %>
        <% end %>
      </div>
    </header>
    <div id="flash_messages" class="pointer-events-none fixed right-4 top-20 z-50 flex flex-col items-end gap-3 sm:right-6">
      <%= render "shared/flash", type: :notice, message: notice if notice.present? %>
      <%= render "shared/flash", type: :alert, message: alert if alert.present? %>
    </div>
    <% if controller_name == "home" && action_name == "index" || controller_name == "terms" && action_name == "show" || controller_name == "privacy" && action_name == "show" %>
      <div class="flex-1 bg-dawn-mist p-4 sm:p-8">
        <div class="mx-auto w-full max-w-5xl rounded-2xl bg-white p-4 shadow-sm sm:p-10">
          <main class="mx-auto flex w-full max-w-4xl flex-col items-center justify-center">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="relative mx-auto mt-10 w-full max-w-3xl flex-1 px-4 pb-10 sm:px-6 lg:px-8">
        <%= yield %>
      </main>
    <% end %>
    <%= render "shared/footer" %>
  </body>
</html>
